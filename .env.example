# Austin Beefs — environment variables (EXAMPLE / PLACEHOLDERS ONLY)
# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Facebook page access token with pages_read_engagement (LISTENING HAND: reads comments off a live post)
FB_PAGE_TOKEN=

# Numeric Facebook Page ID for the Austin Beefs page
FB_PAGE_ID=

# Blotato API key (POSTING HAND) — paste verbatim, keep any trailing "=" signs
BLOTATO_API_KEY=

# Facebook accountId as shown in Blotato settings (which account Blotato posts to)
BLOTATO_FB_ACCOUNT_ID=

# Anthropic API key — only needed later for the full cycle, not for Phase 0
ANTHROPIC_API_KEY=
